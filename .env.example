# GitHub API access (required). A classic PAT with `repo` (or public_repo for
# public-only) scope, or a fine-grained token with Issues: Read access.
# Never commit your real .env — it's gitignored.
GITHUB_TOKEN=

# LLM provider: "anthropic" or "openai". Selects which client the LLM factory builds.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: enables LangSmith tracing on top of our own SQLite trace store.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=issuepilot
