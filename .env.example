# GitHub API access (required). A classic PAT with `repo` (or public_repo for
# public-only) scope, or a fine-grained token with Issues: Read access.
# Never commit your real .env — it's gitignored.
GITHUB_TOKEN=

# LLM provider: "anthropic", "openai", "google" (Gemini) or "gemma" (Google's
# open Gemma models, served by the Gemini API with the same GOOGLE_API_KEY).
# Selects which client the LLM factory builds; the web UI can also switch
# per analysis among providers that have a key.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free tier, no billing setup: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional: gemma-4-26b-a4b-it (fast MoE, default) or gemma-4-31b-it (dense, slower)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional: enables LangSmith tracing on top of our own SQLite trace store.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=issuepilot
